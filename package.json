{
  "name": "confui",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Turn project configuration files into clear, safely editable desktop forms.",
  "author": "1Beyond1",
  "license": "MIT",
  "repository": "https://github.com/1Beyond1/confui",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e-workflow.test.ts tests/ui-e2e.test.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "npm run typecheck && npm test && npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.20.1",
    "electron": "^41.10.2",
    "electron-vite": "^5.0.0",
    "rcedit": "^4.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ini": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "preact": "^10.29.7",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  }
}
